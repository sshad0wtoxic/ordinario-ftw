        <tipo>Especial</tipo>
    </habilidad>

    <habilidad id="h09">
        <nombre>Detectivesco</nombre>
        <descripcion>Habilidad para investigar, analizar pistas y resolver casos.</descripcion>
        <tipo>Mental</tipo>
