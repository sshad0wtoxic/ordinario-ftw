<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE habilidades SYSTEM "habilidades.dtd">

<habilidades>

    <habilidad id="h01">
        <nombre>Super Velocidad</nombre>
        <descripcion>Permite desplazarse a velocidades extremadamente altas.</descripcion>
        <tipo>Fisica</tipo>
    </habilidad>

    <habilidad id="h02">
        <nombre>Vuelo</nombre>
        <descripcion>Capacidad de desplazarse por el aire sin apoyo terrestre.</descripcion>
        <tipo>Movimiento</tipo>
    </habilidad>

    <habilidad id="h03">
        <nombre>Fuerza Sobrehumana</nombre>
        <descripcion>Otorga una fuerza física muy superior a la normal.</descripcion>
        <tipo>Fisica</tipo>
    </habilidad>

    <habilidad id="h04">
        <nombre>Inteligencia Genial</nombre>
        <descripcion>Capacidad intelectual sobresaliente para resolver problemas complejos.</descripcion>
        <tipo>Mental</tipo>
    </habilidad>

    <habilidad id="h05">
        <nombre>Combate Cuerpo a Cuerpo</nombre>
        <descripcion>Dominio de técnicas de lucha física y artes marciales.</descripcion>
        <tipo>Combate</tipo>
    </habilidad>

    <habilidad id="h06">
