    <habilidad id="h18">
        <nombre>Liderazgo</nombre>
        <descripcion>Capacidad para dirigir equipos y coordinar estrategias.</descripcion>
        <tipo>Social</tipo>
    </habilidad>

    <habilidad id="h19">
        <nombre>Poder Cósmico</nombre>
        <descripcion>Manipulación de energías y fuerzas de origen universal.</descripcion>
        <tipo>Cosmico</tipo>
    </habilidad>

    <habilidad id="h20">
        <nombre>Control del Agua</nombre>
        <descripcion>Manipulación y control de masas de agua.</descripcion>
        <tipo>Elemental</tipo>
    </habilidad>

</habilidades>